MYSQL_ROOT_PASSWORD=change_me_mysql_password
MYSQL_DATABASE=aiservice
# RabbitMQ's guest user is restricted to localhost; use an application user.
RABBITMQ_USER=aiservice
RABBITMQ_PASS=change_me_rabbit_password
DASHSCOPE_API_KEY=sk-your_dashscope_key
# Bailian application AppId (legacy variable name retained for compatibility).
KNOWLEDGE_BASE_ID=
BAIDU_CLIENT_ID=your_baidu_client_id
BAIDU_CLIENT_SECRET=your_baidu_client_secret
DOUBAO_API_KEY=ark-your_doubao_key

# Absolute host paths. Build Gemma on the same Linux architecture/toolchain as
# the dependency image; see deploy/README.md. These paths are never app paths.
GEMMA_SOURCE_HOST_DIR=/absolute/path/to/gemma.cpp
GEMMA_BUILD_HOST_DIR=/absolute/path/to/gemma.cpp/build
GEMMA_MODELS_HOST_DIR=/absolute/path/to/gemma-models
# Filenames relative to GEMMA_MODELS_HOST_DIR; no host path here.
GEMMA_MODEL_FILE=2.0-2b-it-sfp.sbs
GEMMA_TOKENIZER_FILE=tokenizer.spm
BUILD_JOBS=2

# Image resource policy: positive decimal integers, read once on first use.
# Configure before starting/recreating the process; BGR bytes are not an RSS cap.
IMAGE_MAX_ENCODED_BYTES=16777216
IMAGE_MAX_ORIGINAL_PIXELS=16777216
IMAGE_MAX_BGR_BYTES=67108864
IMAGE_MAX_CONCURRENT_JOBS=2

# Optional image-recognition override (docker-compose.image.yml) only.
# IMAGE_MODEL_HOST_FILE=/absolute/path/to/mobilenetv2-7.onnx
# IMAGE_LABELS_HOST_FILE=/absolute/path/to/imagenet_classes.txt
